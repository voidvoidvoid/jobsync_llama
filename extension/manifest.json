{
  "manifest_version": 3,
  "name": "JobSync Autofill",
  "version": "0.1.0",
  "description": "Fills in job application forms from your JobSync resume, saved answers and AI provider. You review and submit.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jobsync-autofill@jobsync.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Fill this job application with JobSync",
    "default_icon": "icon.svg"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Fill the job application on this page"
    }
  }
}
